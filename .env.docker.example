# Copy to .env before: docker compose up --build
# DATABASE_URL is overridden in docker-compose.yml to use host "db".

DATABASE_URL=mysql://django:django@db:3306/django_db
SECRET_KEY=change-me-generate-a-strong-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
PATIENT_PAGE_SIZE=10
PATIENT_MAX_PAGE_SIZE=100
