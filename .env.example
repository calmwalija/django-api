# Database (local install — use 127.0.0.1 as host)
DATABASE_URL=mysql://username:password@host:port/database

# Docker Compose overrides DATABASE_URL in docker-compose.yml (host: db).
# For Docker-only setup, see .env.docker.example

# Django — development (copy to .env and adjust)
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT lifetimes (Simple JWT)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

PATIENT_PAGE_SIZE=10
PATIENT_MAX_PAGE_SIZE=100

# Keycloak (v3 patient endpoints)
# Local Docker stack overrides these in docker-compose.yml:
#   KEYCLOAK_PROTOCOL=http, KEYCLOAK_HOST_URL=keycloak:8080
KEYCLOAK_PROTOCOL=https
KEYCLOAK_HOST_URL=auth.example.com
KEYCLOAK_REALM=DjangoApi
KEYCLOAK_CLIENT_ID=djangoapi-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=