# Database (local install — use 127.0.0.1 as host)
DATABASE_URL=mysql://username:password@host:port/database

# Docker Compose overrides DATABASE_URL in docker-compose.yml (host: db).
# For Docker-only setup, see .env.docker.example

# Django — development (copy to .env and adjust)
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1